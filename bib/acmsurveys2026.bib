@article{10.1145/3864440,
author = {Chen, Chen and Kolcun, Roman and Cicconetti, Claudio and Carlini, Emanuele and Mortier, Richard},
title = {Serverless Computing: A Survey of Programming Model, Orchestration, and Opportunities},
year = {2026},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
issn = {0360-0300},
url = {https://doi.org/10.1145/3864440},
doi = {10.1145/3864440},
abstract = {Serverless computing is growing in popularity as a deployment paradigm for micro-services. It brings benefits including simplified management, fine-grained resource accounting and billing, and lightweight virtualisation. In particular, it enables users to focus on function development while service providers focus on efficient resource management and high-performance scheduling. In this article we systematically review serverless computing to facilitate future research and exploration of opportunities enabled by this paradigm. Our primary contribution to the state of the art is to survey and analyse the literature from the perspective of programming models and orchestration. We distinguish six categories of programming models and summarize the various programming languages supported by different platforms. We then analyse orchestration models from cluster, function and kernel perspectives based on their different objectives. We also overview the commercial and open-source platforms that dominate the market at present. Finally, we discuss the research gaps and opportunities in serverless computing that need further attention.},
note = {Just Accepted},
journal = {ACM Comput. Surv.},
month = nov,
keywords = {Serverless computing, FaaS, programming model, orchestration, runtime}
}